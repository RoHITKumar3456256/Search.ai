# Environment Variables Schema & Template for Search.ai

# ==========================================
# PUBLIC BROWSER VARIABLES (Exposed to Client)
# ==========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth & Database Public Client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Analytics & Payments Public Clients (Optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ==========================================
# SERVER ONLY SECRETS (NEVER EXPOSE TO BROWSER)
# ==========================================
SUPABASE_SERVICE_ROLE_KEY=

# Primary & Fallback AI Provider API Keys
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Rate Limiting (Upstash Redis - Optional, fallback to memory in dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Razorpay Payments (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe Payments (Global)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Error Tracking
SENTRY_DSN=
